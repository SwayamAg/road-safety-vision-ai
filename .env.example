# ==============================================================================
# Road Safety Vision-AI: Environment Configuration Template
# Copy this file to `.env` for local execution or configure in cloud dashboard
# (Render.com, Railway.app, Fly.io, AWS ECS, GCP Cloud Run)
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Python Runtime
PYTHON_VERSION=3.10.12

# Storage & Model Directories
MODEL_DIR=models
DATA_IP_DIR=DATA/IP
DATA_OP_DIR=DATA/OP

# Hardware Acceleration ('cuda' for NVIDIA GPU, 'cpu' for fallback)
DEVICE=cpu

# Camera & Visual Odometry Geometry Defaults
CAMERA_HEIGHT_M=1.35
CAMERA_FOV_DEG=65.0

# Road Safety Audit Spatial Capping
DEFAULT_SEGMENT_CAP_M=500.0
DEFAULT_SAMPLE_FPS=5.0
DEFAULT_KEYFRAME_INTERVAL=15
